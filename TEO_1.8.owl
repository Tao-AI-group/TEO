    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <AbbreviatedIRI>span:TemporalInstant</AbbreviatedIRI>
        <Literal>TimeInstant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <AbbreviatedIRI>span:TemporalInterval</AbbreviatedIRI>
        <Literal>TimeInterval</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Clinical_Intervention</IRI>
        <Literal>Clinical Intervention</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Clinical_Intervention</IRI>
        <Literal>Any clinical intervention done on a patient, including medication administration, surgeries, behavioral interventions, clinical trial process, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Diagnosis</IRI>
        <Literal>Diagnosis</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Diagnosis</IRI>
        <Literal>Diseases that have been diagnosed</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Documentation</IRI>
        <Literal>Documentation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Documentation</IRI>
        <Literal>All documentation and non-clinical actions, like check-in, discharge, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Observations</IRI>
        <Literal>Observations</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Observations</IRI>
        <Literal>Symptoms</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Others</IRI>
        <Literal>Others</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Others</IRI>
        <Literal>All other events</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Patient_Accident</IRI>
        <Literal>Patient Accident</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#Patient_Accident</IRI>
        <Literal>All non-clinical actions done on/by the patient, like blunt force, injuries, falls, etc.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000002</IRI>
        <Literal>before</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <IRI>#TEO_0000002</IRI>
        <Literal>&quot;prior to&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000002</IRI>
        <Literal>Interval relation. The source event ended before the start of the target event. It is the same as the point relation &quot;endBeforeStart&quot;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000003</IRI>
        <Literal>during</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000003</IRI>
        <Literal>Interval relation. The source event started after and ended before the target event</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000005</IRI>
        <Literal>hasNormalizedTime</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000005</IRI>
        <Literal>use to represent the normalized view of the time expression of the given instant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000006</IRI>
        <Literal>hasEndTime</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000006</IRI>
        <Literal>Describes the end time of an interval. The domain is a time interval. The range is a time instant.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000007</IRI>
        <Literal>hasValidTime</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000007</IRI>
        <Literal>To link an event with its specific timestamps</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000010</IRI>
        <Literal>contain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000010</IRI>
        <Literal>Interval relation. The source event happened before and ended after the target event</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000011</IRI>
        <Literal>Holiday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000012</IRI>
        <Literal>Time Granularity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <IRI>#TEO_0000012</IRI>
        <Literal>We use grannularity ot define the extent to which the time expression is broken down into small parts, such as day, year, month, etc</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000013</IRI>
        <Literal>US Holiday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000014</IRI>
        <Literal>start</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000014</IRI>
        <Literal>Interval relation. Two events started at the same time and the source event ended before the end of the target event.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000015</IRI>
        <Literal>hasOrigTime</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000015</IRI>
        <Literal>use to represent the original  time expression of the instant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000016</IRI>
        <Literal>after</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:altLabel"/>
        <IRI>#TEO_0000016</IRI>
        <Literal>&quot;post to&quot;</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000016</IRI>
        <Literal>Interval relation. The source event happened after target event. It is the same as the point relation &quot;startAfterEnd&quot;. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000017</IRI>
        <Literal>US Federal Holiday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:editorialNote"/>
        <IRI>#TEO_0000017</IRI>
        <Literal>Defined according to http://en.wikipedia.org/wiki/Public_holidays_in_the_United_States</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000018</IRI>
        <Literal>equal</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000018</IRI>
        <Literal>Interval relation. Two events happened at the same time. It is true when both events are associated with either timeinstants or timeintervals. When both events are associated with time intervals, they must start at the same time and end at the same time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000019</IRI>
        <Literal>First week of a month</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000019</IRI>
        <Literal>The first week of a particular month. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000020</IRI>
        <Literal>meet</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000020</IRI>
        <Literal>Interval relation. The source event ended at (the same time as) the start of the target event. It is the same as the point relation &quot;endEqualStart&quot;.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000021</IRI>
        <Literal>New Year&apos;s Day</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000021</IRI>
        <Literal>Celebrates beginning of the Gregorian calendar year. Festivities include counting down to midnight (12:00 AM) on the preceding night, New Year&apos;s Eve. Traditional end of holiday season.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000022</IRI>
        <Literal>hasDuration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000022</IRI>
        <Literal>Describes the duration of a time interval</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000024</IRI>
        <Literal>TimePhase</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000024</IRI>
        <Literal>A prototype of the repeating interval, specifying the duration of each occurrence and anchors the PeriodicTimeInterval sequence at a certain point in time.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:example"/>
        <IRI>#TEO_0000024</IRI>
        <Literal>In &quot;Every eight hours for two minutes &quot;, 2 minutes can be represented using timephase</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000025</IRI>
        <Literal>Event</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000028</IRI>
        <Literal>hasStartTime</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000028</IRI>
        <Literal>Describes the start time of a time interval. The domain is a time interval and the range is a time instant.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TEO_0000029</IRI>
        <Literal>describe the granularity of a temporal element</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000029</IRI>
        <Literal>hasGranularity</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000030</IRI>
        <Literal>Week</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000030</IRI>
        <Literal>Defines a particular week, where the sequence of the weekdays can be defined using TimeSequence. For example, one can define a week from Monday to Sunday, from Sunday to Sat, or from Tue to Mon.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000031</IRI>
        <Literal>Second week of a month</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000031</IRI>
        <Literal>The second week of a particular month. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000034</IRI>
        <Literal>PeriodicTimeInterval</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
            <Literal>HL7</Literal>
        </Annotation>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000034</IRI>
        <Literal> An interval of time that recurs periodically</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:editorialNote"/>
        <IRI>#TEO_0000034</IRI>
        <Literal>Could have a start time and an end time</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000035</IRI>
        <Literal>third week of a month</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000035</IRI>
        <Literal>The third week of a particular month. </Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000037</IRI>
        <Literal>finish</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000037</IRI>
        <Literal>Interval relation. Two events ended at the same time and the source event started after the start of the target event.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000038</IRI>
        <Literal>overlap</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000038</IRI>
        <Literal>Interval relation. Two events have overlap on the timeline. The source event starts before and  ends before the end of the target event and the source event ends after the start of the target event.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000039</IRI>
        <Literal>temporalRelation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000039</IRI>
        <Literal>The super set of the temporal relations defined in the ontology. Akin to Allen&apos;s temporal operators, but are defined between events instead of time intervals</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:editorialNote"/>
        <IRI>#TEO_0000039</IRI>
        <Literal>An example instant. Maybe deleted later.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#TEO_0000040</IRI>
        <Literal>describe the unit of a duration</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000040</IRI>
        <Literal>hasDurationUnit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000041</IRI>
        <Literal>hasDurationValue</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000041</IRI>
        <Literal>capture the value of a duration, e.g., in &quot;2 hours&quot;, 2 is the duation value and hour is the duation unit</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000042</IRI>
        <Literal>Monday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000042</IRI>
        <Literal>The first day of a calendar week starting from Monday. Monday is after Sunday and before Tuesday.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000043</IRI>
        <Literal>Tuesday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000043</IRI>
        <Literal>The second day of a calendar week starting from Monday. Tuesday is after Monday and before Wednesday.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000045</IRI>
        <Literal>Wednesday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000045</IRI>
        <Literal>The thrid day of a calendar week starting from Monday.  Wednesday is after Tuesday and before Thursday.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000046</IRI>
        <Literal>Thursday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000046</IRI>
        <Literal>The fourth day of a calendar week starting from Monday. Thursday is after Wednesday and before Friday.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#TEO_0000047</IRI>
        <Literal>Friday</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:definition"/>
        <IRI>#TEO_0000047</IRI>
